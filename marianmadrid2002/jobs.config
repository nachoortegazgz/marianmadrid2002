{
  "jobs": [
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "cleanExpiredLocks",
      "description": "Purge expired locks from MM_LOCKS",
      "executionConfig": {
        "cronExpression": "15 * * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "cleanupExpiredDualCache",
      "description": "Purge expired dual slots from DualSlotCache",
      "executionConfig": {
        "cronExpression": "20 * * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "runPendingCompensationsJob",
      "description": "Retry pending compensations and fiscal ledger items",
      "executionConfig": {
        "cronExpression": "30 * * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "cleanExpiredDaysCache",
      "description": "Daily purge of AvailabilityDaysCache",
      "executionConfig": {
        "cronExpression": "0 1 * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "cleanExpiredSlotsCache",
      "description": "Daily purge of AvailabilitySlotsCache",
      "executionConfig": {
        "cronExpression": "10 1 * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "verifyNightlyZClosing",
      "description": "Daily verification of Z closing",
      "executionConfig": {
        "cronExpression": "20 1 * * *"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "cleanAuditLogs",
      "description": "Weekly retention purge of audit logs",
      "executionConfig": {
        "cronExpression": "0 2 * * 0"
      }
    },
    {
      "functionLocation": "/backend/crons.js",
      "functionName": "systemHealthCheck",
      "description": "Daily health check of collections and secrets",
      "executionConfig": {
        "cronExpression": "0 7 * * *"
      }
    }
  ]
}
